{%- liquid
  assign s = section.settings
  assign product = s.product

  comment
    The live product price and the static price line are mutually exclusive, so
    the two can never disagree in front of a buyer.
  endcomment
  assign show_live_price = false
  if product != blank and s.show_price
    assign show_live_price = true
  endif
-%}

<section class="aurora aurora-hero" style="{% render 'aurora-spacing', settings: section.settings %}">
  <div class="aurora__inner aurora-hero__inner">
    <div class="aurora-hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="aurora__eyebrow aurora-reveal">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="aurora__display aurora-hero__title aurora-reveal" style="--aur-reveal-delay: 80ms">
        {{ s.heading }}
      </h1>

      {%- if s.subheading != blank -%}
        <p class="aurora__lede aurora-reveal" style="--aur-reveal-delay: 160ms">{{ s.subheading }}</p>
      {%- endif -%}

      {%- comment -%} One call to action. Nothing competes with it. {%- endcomment -%}
      <div class="aurora-hero__action aurora-reveal" style="--aur-reveal-delay: 240ms">
        <a class="aurora__btn aurora__btn--primary" id="aurora-hero-cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
          {{ s.cta_label }}
          {%- if show_live_price -%}
            <span class="aurora__price">{{ product.price | money }}</span>
          {%- endif -%}
        </a>

        {%- comment -%}
          The price sits at the point of decision. Without a product connected
          the button carries no figure at all, so the cost of the one thing this
          page is selling was never stated above the fold.
        {%- endcomment -%}
        {%- if show_live_price == false and s.price_note != blank -%}
          <div class="aur-price-signal">{{ s.price_note }}</div>
        {%- endif -%}

        {%- if s.assurance != blank -%}
          <p class="aurora-hero__assurance">{{ s.assurance }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="aurora-hero__media aurora-reveal" style="--aur-reveal-delay: 120ms">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(max-width: 989px) 100vw, 48vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: s.image.alt | default: s.heading | strip_html
        }}
      {%- else -%}
        {%- comment -%}
          Ships with real product photography rather than a grey placeholder, so
          the theme is presentable the moment it is installed. Replace it by
          setting a Product image in the theme editor.
        {%- endcomment -%}
        <img
          src="{{ 'aurora-hero-rings.jpg' | asset_url }}"
          width="1200"
          height="1262"
          loading="eager"
          fetchpriority="high"
          alt="Three Aurora rings in black, rose gold and copper finishes"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurora-hero {
    padding-block: var(--padding-block-start, 0) var(--padding-block-end, 0);
  }

  .aurora-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 8vh, 6rem);
  }

  /* The product sits on the page itself — no card, no border, no shadow. The
     studio backdrop is keyed to the page colour in the asset itself, so no
     blend mode is needed (multiply would only darken the whole photograph). */
  .aurora-hero__media img,
  .aurora-hero__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Phones: type first, then the photograph in its own full-width band.
     The previous treatment laid the copy over a full-height cover crop of the
     asset, which produced two faults that pulled against each other. Cover
     against a 0.53-ratio viewport with a 0.95-ratio asset scales to fill the
     height and throws away ~45% of the frame's width, so only the middle ring
     survived the crop; and the copy then had to be pushed into the lower half
     to clear what was left of the product, which is why the eyebrow started
     mid-screen. Neither could be fixed without making the other worse.
     Stacking settles both at once: the type starts at the top of the section,
     and the photograph renders at its own aspect ratio underneath, so all
     three rings read whole. The action still lands above the fold. */
  @media screen and (max-width: 989px) {
    .aurora-hero__inner {
      gap: clamp(1.5rem, 5vh, 2.5rem);
      padding-block: clamp(1.5rem, 5vh, 2.5rem) 0;
    }

    /* Edge to edge, so the photograph is the width of the phone rather than a
       card inset by the gutter. Expressed as one margin pair rather than as a
       relative offset: the box's own layout width stays 100vw and its used
       position lands on the viewport edges, so nothing overhangs the document
       and no horizontal scroll appears. */
    .aurora-hero__media {
      width: 100vw;
      margin-inline: calc(50% - 50vw);
    }

    /* No crop at all in the normal case — height follows the asset's own
       ratio. object-fit only engages if the cap below clamps an unusually
       tall merchant upload, and contain letterboxes onto the page colour the
       studio backdrop is already keyed to, so the bars are invisible. */
    .aurora-hero__media img,
    .aurora-hero__media svg {
      max-height: 62vh;
      max-height: 62svh;
      object-fit: contain;
    }

    .aurora-hero__title {
      max-width: 18ch;
    }

    .aurora-hero__action {
      margin-top: clamp(1.25rem, 4vw, 1.75rem);
    }
  }

  .aurora-hero__title {
    max-width: 12ch;
  }

  .aurora-hero__action {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .aurora-hero__assurance {
    margin: 1.125rem 0 0;
    font-size: 0.8125rem;
    color: var(--aur-text-muted);
  }

  .aurora-hero__placeholder {
    background: var(--aur-page-alt);
    fill: rgba(20, 21, 26, 0.12);
  }

  @media screen and (min-width: 990px) {
    .aurora-hero__inner {
      /* The product gets the larger share — it is the reason anyone is here */
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
      /* No min-height. An 82vh floor made the grid row taller than either
         column, and the inherited align-items: center then split the surplus
         evenly above and below the copy — 218px of dead space over the eyebrow
         at 1440x900. Sizing the row from its content removes the surplus at
         source, so the offset below is the only thing setting the top edge. */
      align-items: start;
      padding-block: var(--aur-hero-top) var(--aur-hero-bottom);
    }

    /* A deliberate drop, so the headline reads against the upper third of the
       product rather than butting against the grid line. */
    .aurora-hero__copy {
      padding-block-start: var(--aur-hero-top);
    }

    /* Contained, not bled. Running the photograph past the container clipped
       the lower-right ring mid-band, which read as an accident rather than as
       a crop. All three rings now sit inside the column, whole. */
    .aurora-hero__media {
      margin-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aurora hero",
  "tag": "section",
  "class": "aurora-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The smart ring without the subscription" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep is the <em>whole</em> game."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Aurora measures your nights and tells you one thing each morning: push, or hold back. Buy it once and every insight is yours for good."
    },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "header", "content": "Action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy Aurora" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Product (for live price)" },
    { "type": "checkbox", "id": "show_price", "label": "Show price in button", "default": true },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price line",
      "info": "Shown under the button when no product is connected above.",
      "default": "€249 (VAT incl.)"
    },
    {
      "type": "text",
      "id": "assurance",
      "label": "Assurance line",
      "default": "Free EU delivery · Free size exchange · No subscription, ever"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [{ "name": "Aurora hero", "category": "Aurora" }]
}
{% endschema %}
