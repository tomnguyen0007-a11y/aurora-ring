{%- liquid
  assign s = section.settings
  assign product = s.product
-%}

<section class="aurora aurora-hero" style="{% render 'aurora-spacing', settings: section.settings %}">
  <div class="aurora__inner aurora-hero__inner">
    <div class="aurora-hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="aurora__eyebrow aurora-reveal">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="aurora__display aurora-hero__title aurora-reveal" style="--aur-reveal-delay: 80ms">
        {{ s.heading }}
      </h1>

      {%- if s.subheading != blank -%}
        <p class="aurora__lede aurora-reveal" style="--aur-reveal-delay: 160ms">{{ s.subheading }}</p>
      {%- endif -%}

      {%- comment -%} One call to action. Nothing competes with it. {%- endcomment -%}
      <div class="aurora-hero__action aurora-reveal" style="--aur-reveal-delay: 240ms">
        <a class="aurora__btn aurora__btn--primary" id="aurora-hero-cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
          {{ s.cta_label }}
          {%- if product != blank and s.show_price -%}
            <span class="aurora__price">{{ product.price | money }}</span>
          {%- endif -%}
        </a>

        {%- if s.assurance != blank -%}
          <p class="aurora-hero__assurance">{{ s.assurance }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="aurora-hero__media aurora-reveal" style="--aur-reveal-delay: 120ms">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(max-width: 989px) 100vw, 48vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: s.image.alt | default: s.heading | strip_html
        }}
      {%- else -%}
        {%- comment -%}
          Ships with real product photography rather than a grey placeholder, so
          the theme is presentable the moment it is installed. Replace it by
          setting a Product image in the theme editor.
        {%- endcomment -%}
        <img
          src="{{ 'aurora-hero-rings.jpg' | asset_url }}"
          width="1200"
          height="1262"
          loading="eager"
          fetchpriority="high"
          alt="Three Aurora rings in black, rose gold and copper finishes"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurora-hero {
    padding-block: var(--padding-block-start, 0) var(--padding-block-end, 0);

    /* Warm ink family — reads as ink on bone, not black on white.
       Measured on #f7f6f3: 15.1:1 / 11.0:1 / 6.0:1. All pass WCAG AA. */
    --aur-hero-ink: #241f1a;
    --aur-hero-ink-soft: #3d362d;
    --aur-hero-ink-quiet: #6b5b48;
  }

  .aurora-hero .aurora__eyebrow {
    color: var(--aur-hero-ink-quiet);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .aurora-hero__title {
    color: var(--aur-hero-ink);
    max-width: 12ch;
  }

  .aurora-hero .aurora__lede {
    color: var(--aur-hero-ink-soft);
  }

  .aurora-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 8vh, 6rem);
  }

  /* The product sits on the page itself — no card, no border, no shadow. */
  .aurora-hero__media img,
  .aurora-hero__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Phones: copy owns the top-left on clean page colour, photograph owns the
     bottom edge-to-edge. Nothing sits on top of the product, so the type needs
     no scrim and the photo stays raw. */
  @media screen and (max-width: 989px) {
    .aurora-hero__inner {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0;
      min-height: 90vh;
      padding-block: 0;
    }

    .aurora-hero__copy {
      position: relative;
      z-index: 2;
      flex: 0 0 auto;
      padding-block: clamp(1.25rem, 3.5vh, 2rem) clamp(1.75rem, 4.5vh, 2.5rem);
    }

    /* Full-bleed out of the padded container, then takes every remaining pixel.
       Because it is now a flex item rather than inset:0, the cover-scaled image
       finally has vertical overflow — which is what makes object-position work. */
    .aurora-hero__media {
      position: relative;
      z-index: 1;
      flex: 1 1 auto;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-top: calc(-1 * clamp(1.5rem, 4.5vh, 2.25rem));
      min-height: 46vh;
    }

    .aurora-hero__media img,
    .aurora-hero__media svg {
      height: 100%;
      object-fit: cover;
      object-position: center 60%;
      /* Top edge dissolves into the page instead of being a cut rectangle. */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 15%);
      mask-image: linear-gradient(to bottom, transparent 0, #000 15%);
    }

    .aurora-hero .aurora__lede {
      max-width: 33ch;
    }

    .aurora-hero__action {
      margin-top: clamp(1.5rem, 4.5vh, 2rem);
    }
  }

  .aurora-hero__action {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .aurora-hero__assurance {
    margin: 1.125rem 0 0;
    font-size: 0.8125rem;
    color: var(--aur-hero-ink-quiet);
  }

  .aurora-hero__placeholder {
    background: var(--aur-page-alt);
    fill: rgba(20, 21, 26, 0.12);
  }

  @media screen and (min-width: 990px) {
    .aurora-hero__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
      padding-block: var(--aur-hero-top) var(--aur-hero-bottom);
    }

    .aurora-hero__copy {
      padding-block-start: var(--aur-hero-top);
    }

    .aurora-hero__media {
      margin-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aurora hero",
  "tag": "section",
  "class": "aurora-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The smart ring without the subscription" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep is the <em>whole</em> game."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Aurora measures your nights and tells you one thing each morning: push, or hold back. Buy it once and every insight is yours for good."
    },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "header", "content": "Action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy Aurora" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Product (for live price)" },
    { "type": "checkbox", "id": "show_price", "label": "Show price in button", "default": true },
    {
      "type": "text",
      "id": "assurance",
      "label": "Assurance line",
      "default": "Free EU delivery · Free size exchange · No subscription, ever"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [{ "name": "Aurora hero", "category": "Aurora" }]
}
{% endschema %}