{%- liquid
  assign s = section.settings
  assign product = s.product
-%}

<section class="aurora aurora-hero" style="{% render 'aurora-spacing', settings: section.settings %}">
  <div class="aurora__inner aurora-hero__inner">
    <div class="aurora-hero__copy">
      
      <!-- TOP GROUP: Pinned to top left -->
      <div class="aurora-hero__top-group">
        {%- if s.eyebrow != blank -%}
          <p class="aurora__eyebrow aurora-reveal">{{ s.eyebrow }}</p>
        {%- endif -%}

        <h1 class="aurora__display aurora-hero__title aurora-reveal" style="--aur-reveal-delay: 80ms">
          {{ s.heading }}
        </h1>
      </div>

      <!-- BOTTOM GROUP: Positioned under the black ring with localized glass/translucent backdrop -->
      <div class="aurora-hero__bottom-group aurora-reveal" style="--aur-reveal-delay: 160ms">
        {%- if s.subheading != blank -%}
          <p class="aurora__lede">{{ s.subheading }}</p>
        {%- endif -%}

        <div class="aurora-hero__action">
          <a class="aurora__btn aurora__btn--primary" id="aurora-hero-cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
            {{ s.cta_label }}
            {%- if product != blank and s.show_price -%}
              <span class="aurora__price">{{ product.price | money }}</span>
            {%- endif -%}
          </a>

          {%- if s.assurance != blank -%}
            <p class="aurora-hero__assurance">{{ s.assurance }}</p>
          {%- endif -%}
        </div>
      </div>

    </div>

    <div class="aurora-hero__media aurora-reveal" style="--aur-reveal-delay: 120ms">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(max-width: 989px) 100vw, 48vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: s.image.alt | default: s.heading | strip_html
        }}
      {%- else -%}
        <img
          src="{{ 'aurora-hero-rings.jpg' | asset_url }}"
          width="1200"
          height="1262"
          loading="eager"
          fetchpriority="high"
          alt="Three Aurora rings in black, rose gold and copper finishes"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurora-hero {
    padding-block: var(--padding-block-start, 0) var(--padding-block-end, 0);
  }

  .aurora-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 8vh, 6rem);
  }

  .aurora-hero__media img,
  .aurora-hero__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* --- MOBILE EDITORIAL LAYOUT --- */
  @media screen and (max-width: 989px) {
    .aurora-hero__inner {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 90vh;
      min-height: 650px;
      padding-block: 0;
    }

    .aurora-hero__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .aurora-hero__media img,
    .aurora-hero__media svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 25%;
    }

    /* Absolutely NO global overlays or dark filters */
    .aurora-hero__media::after {
      display: none !important;
    }

    .aurora-hero__copy {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between; /* Creates the intentional empty middle space */
      height: 100%;
      padding: 3rem 1.25rem 2rem;
    }

    .aurora__eyebrow {
      color: #111111;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    .aurora-hero__title {
      color: #111111;
      font-size: clamp(2.25rem, 8.5vw, 2.75rem);
      line-height: 1.1;
      margin: 0;
      max-width: 13ch;
    }

    /* Localized translucent background & soft blur behind the lower text block */
    .aurora-hero__bottom-group {
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 1.25rem;
      border-radius: 14px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.4);
    }

    .aurora__lede {
      color: #222222;
      font-size: 0.9375rem;
      line-height: 1.45;
      font-weight: 400;
      margin: 0 0 1.25rem 0;
      text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
    }

    .aurora-hero__action {
      margin-top: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .aurora__btn--primary {
      background: #111111;
      color: #ffffff;
      border: none;
      width: 100%;
      justify-content: center;
    }

    .aurora-hero__assurance {
      margin: 0;
      font-size: 0.725rem;
      color: #555555;
      text-align: center;
    }
  }

  /* --- DESKTOP STYLES --- */
  .aurora-hero__title {
    max-width: 12ch;
  }

  .aurora-hero__action {
    margin-top: clamp(1.5rem, 4vw, 2rem);
  }

  .aurora-hero__assurance {
    margin: 0.875rem 0 0;
    font-size: 0.8125rem;
    color: var(--aur-text-muted);
  }

  @media screen and (min-width: 990px) {
    .aurora-hero__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
      padding-block: var(--aur-hero-top) var(--aur-hero-bottom);
    }

    .aurora-hero__copy {
      display: block;
      padding-block-start: var(--aur-hero-top);
    }

    .aurora-hero__bottom-group {
      margin-top: 2rem;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      padding: 0;
      border-radius: 0;
      box-shadow: none;
      border: none;
    }

    .aurora-hero__media {
      margin-right: 0;
    }
    
    .aurora__lede {
      color: var(--aur-text-main) !important;
      text-shadow: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aurora hero",
  "tag": "section",
  "class": "aurora-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The smart ring without the subscription" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep is the <em>whole</em> game."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Aurora measures your nights and tells you one thing each morning: push, or hold back. Buy it once and every insight is yours for good."
    },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "header", "content": "Action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy Aurora" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Product (for live price)" },
    { "type": "checkbox", "id": "show_price", "label": "Show price in button", "default": true },
    {
      "type": "text",
      "id": "assurance",
      "label": "Assurance line",
      "default": "Free Sizing Kit Included · 30-Day Risk-Free Trial · 2-Year Warranty"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [{ "name": "Aurora hero", "category": "Aurora" }]
}
{% endschema %}