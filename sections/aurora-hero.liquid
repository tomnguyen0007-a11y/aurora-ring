{%- liquid
  assign s = section.settings
  assign product = s.product
-%}

<section class="aurora aurora-hero" style="{% render 'aurora-spacing', settings: section.settings %}">
  <div class="aurora__inner aurora-hero__inner">
    <div class="aurora-hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="aurora__eyebrow aurora-reveal">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="aurora__display aurora-hero__title aurora-reveal" style="--aur-reveal-delay: 80ms">
        {{ s.heading }}
      </h1>

      {%- if s.subheading != blank -%}
        <p class="aurora__lede aurora-reveal" style="--aur-reveal-delay: 160ms">{{ s.subheading }}</p>
      {%- endif -%}

    </div>

    {%- comment -%}
      On a phone the product comes before the ask: statement, object, buy. It
      is the only element that runs the full width of the screen, which is what
      makes the section read as a product rather than as a page with a picture
      on it.
    {%- endcomment -%}
    <div class="aurora-hero__media aurora-reveal" style="--aur-reveal-delay: 120ms">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(max-width: 989px) 100vw, 48vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: s.image.alt | default: s.heading | strip_html
        }}
      {%- else -%}
        {%- comment -%}
          The still life. Three finishes, no props, no card, no ground.

          Each source still is photographed on pure white, and the blend mode
          in the stylesheet turns that white into the page — so these are
          cut-outs without being cut-out files. Do not replace these with
          images shot on any other backdrop: a grey or gradient studio floor
          will blend to a visible grey shape.
        {%- endcomment -%}
        <div class="aurora-still">
          <img
            class="aurora-still__ring aurora-still__ring--gold"
            src="{{ s.ring_gold }}&width=900"
            width="1000"
            height="1000"
            loading="eager"
            fetchpriority="high"
            alt="The Aurora ring in gold"
          >
          <img
            class="aurora-still__ring aurora-still__ring--graphite"
            src="{{ s.ring_graphite }}&width=700"
            width="1000"
            height="1000"
            loading="eager"
            alt="The Aurora ring in graphite"
          >
          <img
            class="aurora-still__ring aurora-still__ring--silver"
            src="{{ s.ring_silver }}&width=650"
            width="1000"
            height="1000"
            loading="eager"
            alt="The Aurora ring in silver"
          >
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} One call to action. Nothing competes with it. {%- endcomment -%}
    <div class="aurora-hero__action aurora-reveal" style="--aur-reveal-delay: 240ms">
      <a class="aurora__btn aurora__btn--primary" id="aurora-hero-cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
        {{ s.cta_label }}
        {%- if product != blank and s.show_price -%}
          <span class="aurora__price">{{ product.price | money }}</span>
        {%- endif -%}
      </a>

      {%- if s.assurance != blank -%}
        <p class="aurora-hero__assurance">
          {%- assign promises = s.assurance | split: '·' -%}
          {%- for promise in promises -%}
            <span>{{ promise | strip }}</span>
          {%- endfor -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurora-hero {
    padding-block: var(--padding-block-start, 0) var(--padding-block-end, 0);

    /* Warm ink family — reads as ink on bone, not black on white.
       Measured on #f7f6f3: 15.1:1 / 11.0:1 / 4.9:1. All pass WCAG AA. */
    --aur-hero-ink: #241f1a;
    --aur-hero-ink-soft: #3d362d;
    --aur-hero-ink-quiet: #6f6a63;
  }

  .aurora-hero .aurora__eyebrow {
    color: var(--aur-hero-ink-quiet);
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .aurora-hero__title {
    color: var(--aur-hero-ink);
    max-width: 12ch;
  }

  .aurora-hero .aurora__lede {
    color: var(--aur-hero-ink-soft);
  }

  .aurora-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 8vh, 6rem);
  }

  /* The product sits on the page itself — no card, no border, no shadow. */
  .aurora-hero__media img,
  .aurora-hero__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- The still life ----
     Three finishes arranged, rather than a photograph of three rings on props.

     How the cut-out works, because it is not obvious from the markup: every
     source still is shot on pure white — measured, corner pixel is exactly
     255,255,255 and the ring occupies 13.6%–86.4% of the frame. `darken`
     keeps whichever channel is lower, so against bone every white pixel
     resolves to bone and only the ring survives. The result is a cut-out with
     no alpha channel, no generated asset, and no rectangle edge anywhere —
     which is the one thing the wooden-prop photograph could never lose, since
     its content ran to the bottom of its own frame.

     Requirement: the stills must stay on white. A grey or gradient studio
     backdrop will blend to a visible grey shape instead of disappearing.

     Everything is a percentage of the container, so one composition serves
     every width. */
  .aurora-still {
    position: relative;
    width: 100%;
    aspect-ratio: 39 / 31;
  }

  .aurora-still__ring {
    position: absolute;
    display: block;
    height: auto;
    mix-blend-mode: darken;
    /* Three sensor arrays in one frame: the LEDs photograph hotter than they
       read in life and were the first thing the eye landed on. */
    filter: saturate(0.92);
  }

  .aurora-still__ring--gold {
    width: 70%;
    left: 18%;
    top: -3%;
  }

  .aurora-still__ring--graphite {
    width: 50%;
    left: -6%;
    top: 28%;
  }

  .aurora-still__ring--silver {
    width: 46%;
    left: 58%;
    top: 42%;
  }

  /* ---- Base rhythm for the action ----
     These sit ABOVE the phone block on purpose. They have the same
     specificity as the phone rules, so when they sat below them they won on
     source order alone and silently reverted every margin the phone block
     set — which is where the 50px gap between the photograph and the button
     came from, and why the promises lost their hung marks. */
  .aurora-hero__action {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .aurora-hero__assurance {
    margin: 1.125rem 0 0;
    font-size: 0.8125rem;
    color: var(--aur-hero-ink-quiet);
  }

  .aurora-hero__assurance span:not(:last-child)::after {
    content: '·';
    margin: 0 0.375rem;
  }

  .aurora-hero__placeholder {
    background: var(--aur-page-alt);
    fill: rgba(20, 21, 26, 0.12);
  }

  /* ---------------------------------------------------------------------
     Phones: one axis, one object, one ask.

     Everything — eyebrow, headline, sentence, hairline, button — is set on
     the same 24px axis, and the still life is the single element that leaves
     it, bleeding to both screen edges by exactly the gutter.

     Two structural bugs are fixed here rather than compensated for:

     1. This element switched to a flex column but kept `align-items: center`
        from the rule above. Flex items therefore shrank to their content and
        centred themselves, so the 100vw media rendered at left: -12px — a
        12px overhang on one edge and a 12px bone gap on the other — and the
        action floated free of the text axis. `align-items: stretch` fixes
        both at source.

     2. The photograph was capped with max-height + object-fit: contain, which
        letterboxed it and put the rings' optical edge at 7px against a 24px
        type axis. The still life needs no cap: it is sized by its own
        aspect-ratio box.
     --------------------------------------------------------------------- */
  @media screen and (max-width: 989px) {
    .aurora-hero__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: clamp(0.25rem, 1vh, 0.5rem) clamp(0.75rem, 2.5vh, 1.25rem);
    }

    /* 10px read as a disclaimer. This line is the frame of reference for a
       brand nobody has heard of — it has to carry like a label, not a
       footnote. Oura sets the equivalent at 14px. */
    .aurora-hero .aurora__eyebrow {
      margin: 0 0 0.875rem;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      line-height: 1.4;
    }

    .aurora-hero__title {
      font-size: clamp(2.5rem, 12.3vw, 3.25rem);
      line-height: 0.96;
      letter-spacing: -0.025em;
      max-width: 11ch;
    }

    .aurora-hero .aurora__lede {
      margin-top: 0.875rem;
      font-size: 0.875rem;
      line-height: 1.5;
      max-width: 34ch;
    }

    /* Bleed by exactly the gutter. No 100vw, no percentage margin: a
       percentage resolves against the flex item's containing block, which is
       not the viewport, and 100vw includes the scrollbar. */
    .aurora-hero__media {
      width: auto;
      margin: 0.875rem calc(-1 * var(--aur-gutter)) 0;
    }

    .aurora-hero__media img,
    .aurora-hero__media svg {
      width: 100%;
      height: auto;
      max-height: none;
      object-fit: contain;
    }

    .aurora-hero__media .aurora-still__ring {
      width: auto;
    }

    .aurora-hero__action {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--aur-line);
      text-align: left;
    }

    /* A pill the width of its own label, on the axis. */
    .aurora-hero__action .aurora__btn--primary {
      display: inline-flex;
      width: auto;
      max-width: none;
      padding: 1rem 2.25rem;
    }

    /* The trust bar renders the same promises, with a line of detail under
       each, 30px below this one — measured 655 against 687. Two of the three
       appeared twice on the same screen. Kept in the DOM for desktop, where
       that section is well below the fold. */
    .aurora-hero__assurance {
      display: none;
    }
  }

  /* Short screens. A 390x844 phone gives the page ~734px once Safari's
     address bar is on screen, so this is keyed to 860 rather than to an SE.
     The still life is sized by aspect-ratio rather than capped, so it needs
     no letterbox here — only the type and the gaps tighten. */
  @media screen and (max-width: 989px) and (max-height: 860px) {
    .aurora-hero__title {
      font-size: clamp(2.125rem, 10.5vw, 2.5rem);
    }

    .aurora-hero .aurora__lede {
      margin-top: 0.75rem;
      font-size: 0.8125rem;
    }

    .aurora-hero__media {
      margin-top: 0.75rem;
    }

    .aurora-hero__action {
      margin-top: 1rem;
      padding-top: 1rem;
    }
  }

  @media screen and (min-width: 990px) {
    .aurora-hero__inner {
      grid-template-columns: 0.9fr 1.1fr;
      grid-template-areas:
        'copy media'
        'action media'
        'slack media';
      /* Three rows, the last one elastic, so the media column's surplus
         height is soaked up below the action rather than shared between the
         rows above it. */
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(2.5rem, 5vw, 5rem);
      row-gap: 0;
      align-items: start;
      padding-block: var(--aur-hero-top) var(--aur-hero-bottom);
    }

    .aurora-hero__copy {
      grid-area: copy;
      padding-block-start: var(--aur-hero-top);
    }

    .aurora-hero__action {
      grid-area: action;
    }

    .aurora-hero__media {
      grid-area: media;
      margin-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aurora hero",
  "tag": "section",
  "class": "aurora-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Smart ring · No subscription" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep is the <em>whole</em> game."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Aurora reads your night, then tells you one thing: push, or hold back."
    },
    { "type": "image_picker", "id": "image", "label": "Product image (overrides the still life)" },
    { "type": "header", "content": "Still life" },
    {
      "type": "paragraph",
      "content": "Three finishes, floated on the page. The stills MUST be photographed on pure white — the white is blended away to reveal the page. A grey or gradient backdrop will show as a grey shape."
    },
    {
      "type": "text",
      "id": "ring_gold",
      "label": "Gold ring image URL",
      "default": "https://cdn.shopify.com/s/files/1/0958/6281/7034/files/IMG_9648.webp?v=1785881926"
    },
    {
      "type": "text",
      "id": "ring_graphite",
      "label": "Graphite ring image URL",
      "default": "https://cdn.shopify.com/s/files/1/0958/6281/7034/files/IMG_9649.webp?v=1785881926"
    },
    {
      "type": "text",
      "id": "ring_silver",
      "label": "Silver ring image URL",
      "default": "https://cdn.shopify.com/s/files/1/0958/6281/7034/files/IMG_9647.webp?v=1785677211"
    },
    { "type": "header", "content": "Action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy Aurora" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Product (for live price)" },
    { "type": "checkbox", "id": "show_price", "label": "Show price in button", "default": true },
    {
      "type": "text",
      "id": "assurance",
      "label": "Assurance line",
      "info": "Separate with ·. Hidden on phones — the trust bar below repeats it.",
      "default": "Free EU delivery · No subscription, ever"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [{ "name": "Aurora hero", "category": "Aurora" }]
}
{% endschema %}
