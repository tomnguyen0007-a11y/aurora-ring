{%- liquid
  assign s = section.settings
  assign product = s.product
-%}

<section class="aurora aurora-hero" style="{% render 'aurora-spacing', settings: section.settings %}">
  <div class="aurora__inner aurora-hero__inner">
    <div class="aurora-hero__copy">
      {%- if s.eyebrow != blank -%}
        <p class="aurora__eyebrow aurora-reveal">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="aurora__display aurora-hero__title aurora-reveal" style="--aur-reveal-delay: 80ms">
        {{ s.heading }}
      </h1>

      {%- if s.subheading != blank -%}
        <p class="aurora__lede aurora-reveal" style="--aur-reveal-delay: 160ms">{{ s.subheading }}</p>
      {%- endif -%}

    </div>

    {%- comment -%}
      On a phone the product comes before the ask: statement, object, buy. It
      is the only element that runs the full width of the screen, which is what
      makes the section read as a product rather than as a page with a picture
      on it.
    {%- endcomment -%}
    <div class="aurora-hero__media aurora-reveal" style="--aur-reveal-delay: 120ms">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '500, 800, 1100, 1400',
            sizes: '(max-width: 989px) 100vw, 48vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: s.image.alt | default: s.heading | strip_html
        }}
      {%- else -%}
        {%- comment -%}
          Ships with real product photography rather than a grey placeholder, so
          the theme is presentable the moment it is installed. Replace it by
          setting a Product image in the theme editor.

          Two crops of the same shot rather than one squeezed into both
          shapes. The phone crop is crop-tight around the three rings so the
          product fills the width; the studio backdrop in both is the page's
          own bone, so neither reads as a picture in a box.
        {%- endcomment -%}
        <picture>
          <source
            media="(max-width: 989px)"
            srcset="{{ 'aurora-hero-rings-phone.jpg' | asset_url }}"
            width="1016"
            height="1065"
          >
          <img
            src="{{ 'aurora-hero-rings.jpg' | asset_url }}"
            width="1200"
            height="1262"
            loading="eager"
            fetchpriority="high"
            alt="Three Aurora rings in black, rose gold and copper finishes"
          >
        </picture>
      {%- endif -%}
    </div>

    {%- comment -%} One call to action. Nothing competes with it. {%- endcomment -%}
    <div class="aurora-hero__action aurora-reveal" style="--aur-reveal-delay: 240ms">
      <a class="aurora__btn aurora__btn--primary" id="aurora-hero-cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
        {{ s.cta_label }}
        {%- if product != blank and s.show_price -%}
          <span class="aurora__price">{{ product.price | money }}</span>
        {%- endif -%}
      </a>

      {%- if s.assurance != blank -%}
        <p class="aurora-hero__assurance">
          {%- assign promises = s.assurance | split: '·' -%}
          {%- for promise in promises -%}
            <span>{{ promise | strip }}</span>
          {%- endfor -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .aurora-hero {
    padding-block: var(--padding-block-start, 0) var(--padding-block-end, 0);

    /* Warm ink family — reads as ink on bone, not black on white.
       Measured on #f7f6f3: 15.1:1 / 11.0:1 / 4.9:1. All pass WCAG AA.
       The quiet tone was #6b5b48, a warm brown that appeared nowhere else in
       the token set; against the photograph's own warm props it read as a
       fourth, unplanned colour. Neutralised, not cooled. */
    --aur-hero-ink: #241f1a;
    --aur-hero-ink-soft: #3d362d;
    --aur-hero-ink-quiet: #6f6a63;
  }

  .aurora-hero .aurora__eyebrow {
    color: var(--aur-hero-ink-quiet);
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .aurora-hero__title {
    color: var(--aur-hero-ink);
    max-width: 12ch;
  }

  .aurora-hero .aurora__lede {
    color: var(--aur-hero-ink-soft);
  }

  .aurora-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 8vh, 6rem);
  }

  /* The product sits on the page itself — no card, no border, no shadow. */
  .aurora-hero__media img,
  .aurora-hero__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------------------------------------------------------------------
     Phones: one axis, one object, one ask.

     Everything — eyebrow, headline, sentence, hairline, button, promises —
     is set on the same 24px axis, and the photograph is the single element
     that leaves it, bleeding to both screen edges by exactly the gutter.

     Two structural bugs are fixed here rather than compensated for:

     1. This element switched to a flex column but kept `align-items: center`
        from the rule above. Flex items therefore shrank to their content and
        centred themselves, so the 100vw media rendered at left: -12px — a
        12px overhang on one edge and a 12px bone gap on the other — and the
        action floated free of the text axis. `align-items: stretch` fixes
        both at source.

     2. The photograph was capped with max-height + object-fit: contain. The
        phone crop is 1016x1065 with its content already 2.5% inside the
        frame, so the cap letterboxed it: at 390px it painted 370 of 390px,
        putting the rings' optical edge at 7px while the type sat at 24px.
        Nothing lined up with anything. It is painted at full width now.
     --------------------------------------------------------------------- */
  @media screen and (max-width: 989px) {
    .aurora-hero__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: clamp(0.25rem, 1vh, 0.5rem) clamp(0.75rem, 2.5vh, 1.25rem);
    }

    .aurora-hero .aurora__eyebrow {
      margin: 0 0 0.875rem;
      font-size: 0.625rem;
      letter-spacing: 0.16em;
      line-height: 1.4;
    }

    /* Scale carries the hierarchy: a 48px headline over a 14px sentence, so
       the eye lands on the claim, then on the object. Sized to hold on two
       lines at 390px without hyphenating. */
    .aurora-hero__title {
      font-size: clamp(2.5rem, 12.3vw, 3.25rem);
      line-height: 0.96;
      letter-spacing: -0.025em;
      max-width: 11ch;
    }

    .aurora-hero .aurora__lede {
      margin-top: 0.875rem;
      font-size: 0.875rem;
      line-height: 1.5;
      max-width: 34ch;
    }

    /* Bleed by exactly the gutter. No 100vw, no percentage margin: a
       percentage resolves against the flex item's containing block, which is
       not the viewport, and 100vw includes the scrollbar. A negative inline
       margin equal to the padding that created the gutter lands on the screen
       edge on every width, and cannot overflow the document. */
    .aurora-hero__media {
      width: auto;
      margin: 1rem calc(-1 * var(--aur-gutter)) 0;
    }

    .aurora-hero__media img,
    .aurora-hero__media svg {
      width: 100%;
      height: auto;
      max-height: none;
      object-fit: contain;
    }

    /* The hairline gives the photograph's lower edge a job. Without it the
       shot reads as a rectangle that happens to stop; with it, it reads as
       the boundary between the object and the ask. */
    .aurora-hero__action {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--aur-line);
      text-align: left;
    }

    /* A pill the width of its own label, on the axis. A full-width slab is
       what every Shopify theme ships; it also reads as urgency, which is the
       opposite of what a considered purchase wants. */
    .aurora-hero__action .aurora__btn--primary {
      display: inline-flex;
      width: auto;
      max-width: none;
      padding: 1rem 2.25rem;
    }

    .aurora-hero__assurance {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem 0.875rem;
      /* Marks hung in the gutter, so the words line up with the button and
         the headline above them. */
      margin: 0.75rem 0 0 -0.5625rem;
      font-size: 0.6875rem;
      line-height: 1.5;
    }

    /* Three promises wrap to a second line at every phone width and that line
       lands under the fold — it was cut off at 863px on an 844px viewport.
       Two hold on one line. The third promise is the eyebrow's claim word for
       word, so the phone loses nothing; desktop still shows all three. */
    .aurora-hero__assurance span:nth-child(n + 3) {
      display: none;
    }

    .aurora-hero__assurance span {
      display: inline-flex;
      align-items: center;
      gap: 0.4375rem;
    }

    /* The desktop separator would otherwise double up with the mark. Scoped
       one level deeper so it wins on specificity rather than on the order the
       two blocks happen to sit in. */
    .aurora-hero .aurora-hero__assurance span:not(:last-child)::after {
      content: none;
    }

    .aurora-hero__assurance span::before {
      content: '';
      flex: none;
      width: 0.1875rem;
      height: 0.1875rem;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.55;
    }
  }

  /* Short screens — an SE, an older Android. A full-width photograph is 1.05x
     the screen width tall, which on a 667px viewport puts the button under the
     fold. Here alone the shot comes back inside the gutter and is capped, so
     the whole section lands on one screen; at this width the letterbox it
     leaves is ~17px a side rather than the 10-67px the cap used to leave at
     every width. */
  @media screen and (max-width: 989px) and (max-height: 720px) {
    .aurora-hero__title {
      font-size: clamp(2.25rem, 11vw, 2.75rem);
    }

    .aurora-hero .aurora__lede {
      margin-top: 0.75rem;
      font-size: 0.8125rem;
    }

    .aurora-hero__media {
      margin-inline: 0;
      margin-top: 0.75rem;
    }

    .aurora-hero__media img,
    .aurora-hero__media svg {
      max-height: 46vh;
      object-fit: contain;
    }

    .aurora-hero__action {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
    }
  }

  .aurora-hero__action {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .aurora-hero__assurance {
    margin: 1.125rem 0 0;
    font-size: 0.8125rem;
    color: var(--aur-hero-ink-quiet);
  }

  .aurora-hero__assurance span:not(:last-child)::after {
    content: '·';
    margin: 0 0.375rem;
  }

  .aurora-hero__placeholder {
    background: var(--aur-page-alt);
    fill: rgba(20, 21, 26, 0.12);
  }

  @media screen and (min-width: 990px) {
    /* Unchanged from before, only re-plumbed: the action is a sibling now, so
       it is placed back into the left column under the copy by name. Row gap
       is zero because the action already carries its own top margin — the
       column gap is the only gap the layout ever wanted. */
    .aurora-hero__inner {
      grid-template-columns: 0.9fr 1.1fr;
      grid-template-areas:
        'copy media'
        'action media'
        'slack media';
      /* Three rows, the last one elastic. The photograph spans the column, and
         with only two rows its surplus height is shared out between them —
         which pushed the button 55px below where it has always sat. The 1fr
         row soaks that surplus up underneath the action instead. */
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(2.5rem, 5vw, 5rem);
      row-gap: 0;
      align-items: start;
      padding-block: var(--aur-hero-top) var(--aur-hero-bottom);
    }

    .aurora-hero__copy {
      grid-area: copy;
      padding-block-start: var(--aur-hero-top);
    }

    .aurora-hero__action {
      grid-area: action;
    }

    .aurora-hero__media {
      grid-area: media;
      margin-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aurora hero",
  "tag": "section",
  "class": "aurora-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The smart ring without the subscription" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep is the <em>whole</em> game."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Aurora measures your nights and tells you one thing each morning: push, or hold back. Buy it once and every insight is yours for good."
    },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "header", "content": "Action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy Aurora" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Product (for live price)" },
    { "type": "checkbox", "id": "show_price", "label": "Show price in button", "default": true },
    {
      "type": "text",
      "id": "assurance",
      "label": "Assurance line",
      "info": "Separate with ·. Phones show the first two.",
      "default": "Free EU delivery · Free size exchange · No subscription, ever"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [{ "name": "Aurora hero", "category": "Aurora" }]
}
{% endschema %}
